# Frontend — producción (API Gateway en AWS)
# Copiar a .env.production (no se versiona) para `npx expo export`.
# En EAS estas variables se definen en el entorno "production" del proyecto.
EXPO_PUBLIC_API_URL_AUTH=https://<api-id>.execute-api.us-east-1.amazonaws.com/auth
EXPO_PUBLIC_API_URL_SHOP=https://<api-id>.execute-api.us-east-1.amazonaws.com/shop
EXPO_PUBLIC_API_URL_CHECKOUT=https://<api-id>.execute-api.us-east-1.amazonaws.com/checkout
EXPO_PUBLIC_API_URL_ORDER=https://<api-id>.execute-api.us-east-1.amazonaws.com/order
EXPO_PUBLIC_API_URL_PAYMENT=https://<api-id>.execute-api.us-east-1.amazonaws.com/payment
# El tracking por Socket.IO necesita un servidor de larga duración (no Lambda)
EXPO_PUBLIC_SOCKET_URL=
EXPO_PUBLIC_API_URL_GOOGLE=https://maps.googleapis.com/maps/api
EXPO_PUBLIC_API_KEY_GOOGLE=
