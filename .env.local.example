# Frontend — local (backends en esta máquina sobre LocalStack)
# Copiar a .env.local (no se versiona). Todo entra por el gateway (nginx) en
# :8080. infra-delivery/local/up.sh fija el host: localhost (web) o la IP de la
# red (--lan, Expo Go).
EXPO_PUBLIC_API_URL_AUTH=http://localhost:8080/auth
EXPO_PUBLIC_API_URL_SHOP=http://localhost:8080/shop
EXPO_PUBLIC_API_URL_CHECKOUT=http://localhost:8080/checkout
EXPO_PUBLIC_API_URL_ORDER=http://localhost:8080/order
EXPO_PUBLIC_API_URL_PAYMENT=http://localhost:8080/payment
EXPO_PUBLIC_SOCKET_URL=http://localhost:8080
# Mapa y geocodificación usan OpenStreetMap (Nominatim + OSRM): no requieren API key.
