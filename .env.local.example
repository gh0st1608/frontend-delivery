# Frontend — local (backends en esta máquina sobre LocalStack)
# Copiar a .env.local (no se versiona). infra-delivery/local/up.sh fija las
# URLs según el modo: localhost (web) o la IP de la red (--lan, Expo Go).
EXPO_PUBLIC_API_URL_AUTH=http://localhost:3000/auth
EXPO_PUBLIC_API_URL_SHOP=http://localhost:3002/shop
EXPO_PUBLIC_API_URL_CHECKOUT=http://localhost:3003/checkout
EXPO_PUBLIC_API_URL_ORDER=http://localhost:3004/order
EXPO_PUBLIC_API_URL_PAYMENT=http://localhost:3005/payment
EXPO_PUBLIC_SOCKET_URL=http://localhost:3004
EXPO_PUBLIC_API_URL_GOOGLE=https://maps.googleapis.com/maps/api
EXPO_PUBLIC_API_KEY_GOOGLE=
